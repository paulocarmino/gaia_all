# Copy to .env at the repo root. .env is gitignored and never committed.

# --- Brain (Ollama Cloud) ---
OLLAMA_API_KEY=
# Model id as listed by GET https://ollama.com/v1/models
GAIA_BRAIN_MODEL=glm-5.2
OLLAMA_BASE_URL=https://ollama.com/v1

# --- Front door ---
# Static bearer token for every exposed core endpoint.
GAIA_AUTH_TOKEN=

# --- Core service ---
GAIA_PORT=3000

# --- Mnemosyne (memory service) ---
# Declared, never hardcoded: this is how the core reaches memory.
MNEMOSYNE_URL=http://127.0.0.1:3001
MNEMOSYNE_PORT=3001
MNEMOSYNE_DB_PATH=./data/mnemosyne.db
